+/* Width scan: the car turns this far each way and scans again, so the
+   sweep reaches past each box edge plus the beam (3 Nov: a centred box
+   echoed at every angle of the +/-25 deg sweep). */
+#define WIDTH_TURN_DEG (40.0f)     /* [CALIBRATE] */
+#define TURN_WAIT_MS   (5000)
+/* The beam still hears the box this far off its axis: the corrected edge
+   uses the beam's inner side (150 mm box read 235-255 mm raw, 142-172 mm
+   corrected, 3 Nov).  Width scan only: not OBST_BEAM_HALF_DEG, which
+   would move the mission's pass. */
+#define WIDTH_BEAM_DEG (12.0f)     /* [CALIBRATE] */
